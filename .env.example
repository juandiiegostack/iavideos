# Copy this file to ".env" and fill in what you need.
# ClipHunter never stores secrets in the repository; everything is optional.

# ------------------------------------------------------------------ Optional LLM
# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, LM Studio...).
# CLIPHUNTER_LLM_BASE_URL=https://api.openai.com/v1
# CLIPHUNTER_LLM_API_KEY=sk-...
# CLIPHUNTER_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------ Other options
# Cache directory (defaults to the OS user cache directory).
# CLIPHUNTER_CACHE_DIR=C:\ruta\a\cache

# Whisper model name (tiny, base, small, medium, large-v3...).
# CLIPHUNTER_WHISPER_MODEL=small

# Use custom binaries instead of the ones found on PATH.
# CLIPHUNTER_FFMPEG=C:\ruta\ffmpeg.exe
# CLIPHUNTER_FFPROBE=C:\ruta\ffprobe.exe
# CLIPHUNTER_STREAMLINK=C:\ruta\streamlink.exe
# CLIPHUNTER_TWITCHDOWNLOADER=C:\ruta\TwitchDownloaderCLI.exe
